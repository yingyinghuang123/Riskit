{
  "name": "riskit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "esbuild src/game.ts --bundle --outfile=game.js --format=iife --target=es2017 --minify",
    "build:watch": "esbuild src/game.ts --bundle --outfile=game.js --format=iife --target=es2017 --watch",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.cjs"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "esbuild": "^0.20.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "localtunnel": "^2.0.2",
    "pixi.js": "8.17.0",
    "planck": "^1.4.3",
    "three": "0.183.2",
    "ws": "^8.20.0"
  }
}
